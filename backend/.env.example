# ── Server ──────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# ── Database ────────────────────────────
# MongoDB connection string
DATABASE_URL=mongodb://localhost:27017/prompt-manager

# ── JWT ─────────────────────────────────
# Use long, random strings (min 10 chars). Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret

# ── Frontend ────────────────────────────
# Origin allowed by CORS
FRONTEND_URL=http://localhost:5173

# ── Admin seed (scripts/seed-admin.ts) ──
# Required to run the admin seed. Min 8 characters. Rotate after first login.
ADMIN_EMAIL=admin@aipromptmanager.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
